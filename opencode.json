{
  "$schema": "https://opencode.ai/config.schema.json",
  "provider": {
    "github-copilot": {}
  },
  "model": "github-copilot/claude-sonnet-4.6",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "mcp": {
    "onetable-food": {
      "type": "local",
      "command": ["node", "D:/ZeroJarvis/services/gateway/src/onetable-food/mcp-server.cjs"],
      "enabled": true
    },
    "twinkle-hub": {
      "type": "remote",
      "url": "https://api.twinkleai.tw/mcp/",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:TWINKLE_HUB_API_KEY}"
      },
      "enabled": true
    }
  },
  "tools": {
    "write": true,
    "edit": true,
    "bash": true,
    "read": true,
    "grep": true,
    "glob": true,
    "patch": true,
    "webfetch": true,
    "websearch": true,
    "todowrite": true,
    "skill": true,
    "question": false
  },
  "instructions": [
    ".opencode/instructions.md"
  ]
}
