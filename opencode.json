{
  "$schema": "https://opencode.ai/config.schema.json",
  "provider": {
    "github-copilot": {}
  },
  "model": "github-copilot/claude-sonnet-4.6",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "tools": {
    "write": true,
    "edit": true,
    "bash": true,
    "read": true,
    "grep": true,
    "glob": true,
    "patch": true,
    "webfetch": true,
    "websearch": true,
    "todowrite": true,
    "skill": true,
    "question": false
  },
  "instructions": [
    ".opencode/instructions.md"
  ],
  "mcp": {
    "notebooklm": {
      "type": "local",
      "command": ["npx", "-y", "notebooklm-mcp@latest"],
      "enabled": true,
      "timeout": 30000,
      "environment": {
        "HEADLESS": "true",
        "NOTEBOOKLM_AI_MARKER": "false",
        "NOTEBOOKLM_PROFILE": "full"
      }
    }
  }
}
