{
  "name": "zerojarvis",
  "version": "0.1.0",
  "private": true,
  "description": "Jarvis-like voice AI assistant with vision capabilities",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @zerojarvis/web dev",
    "dev:gateway": "pnpm --filter @zerojarvis/gateway dev",
    "dev:desktop": "pnpm --filter @zerojarvis/desktop dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
