{
  "$schema": "https://raw.githubusercontent.com/nickelpack/tauri/dev/packages/tauri/schema.json",
  "productName": "ZeroJarvis",
  "identifier": "com.zerojarvis.app",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../web/build",
    "devUrl": "https://localhost:3000",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "ZeroJarvis",
        "width": 800,
        "height": 900,
        "resizable": true,
        "transparent": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://localhost:* wss://localhost:* http://localhost:* https://localhost:*; media-src 'self' blob:; img-src 'self' data: blob:; script-src 'self' 'unsafe-inline'; frame-src 'self' https://www.google.com"
    }
  },
  "plugins": {}
}
