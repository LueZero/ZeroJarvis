# === OpenCode (LLM 統一入口) ===
# OpenCode serve 的 URL（先啟動 opencode serve）
OPENCODE_URL=http://localhost:4096
# 設為 true 讓 Gateway 內嵌啟動 OpenCode server（不需要另開 opencode serve）
OPENCODE_EMBEDDED=false

# === STT ===
# Groq Whisper API (免費，需要申請 key)
# 取得: https://console.groq.com/keys
GROQ_API_KEY=

# Option A: Local faster-whisper (default, no key needed)
# Option B: Deepgram cloud
DEEPGRAM_API_KEY=

# === TTS ===
# Option A: Edge TTS (free, no key needed)
# 語音選擇 (預設 zh-TW-HsiaoChenNeural)
TTS_VOICE=zh-TW-HsiaoChenNeural
# Option B: ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# === Gateway ===
GATEWAY_PORT=3100
GATEWAY_HOST=localhost
