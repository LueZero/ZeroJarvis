# === OpenCode (LLM 統一入口) ===
# OpenCode serve 的 URL（先啟動 opencode serve）
OPENCODE_URL=http://localhost:4096
# 設為 true 讓 Gateway 內嵌啟動 OpenCode server（不需要另開 opencode serve）
OPENCODE_EMBEDDED=false

# === STT ===
# Groq Whisper API (免費，需要申請 key)
# 取得: https://console.groq.com/keys
GROQ_API_KEY=

# Option A: Local faster-whisper (default, no key needed)
# Option B: Deepgram cloud
DEEPGRAM_API_KEY=

# === TTS ===
# TTS_PROVIDER: openai (預設) | edge (免費 Edge TTS)
TTS_PROVIDER=openai

# OpenAI TTS 設定
# 取得: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
# 可選聲音: alloy, echo, fable, onyx, nova, shimmer
# 可選模型: tts-1 (快), tts-1-hd (高品質)

# === Gateway ===
GATEWAY_PORT=3100
GATEWAY_HOST=localhost

# === YouTube (MCP: youtube-toolkit) ===
# YouTube Data API v3 Key
# 取得: https://console.cloud.google.com/apis/credentials
# 啟用: YouTube Data API v3
YOUTUBE_API_KEY=

# === Twinkle Hub (台灣資料 MCP) ===
# Alpha 免費，取得 key: https://hub.twinkleai.tw/login → dashboard
TWINKLE_HUB_API_KEY=sk-lCIEQUHQBfxO2vhy65l2LA